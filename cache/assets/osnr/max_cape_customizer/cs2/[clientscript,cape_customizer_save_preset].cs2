// 20566
[clientscript,cape_customizer_save_preset](int $preset_index)
def_string $msg = "The previous colors in this preset will be replaced by the colors currently selected for each part. Are you sure you wish to override this save?";
~cape_customizer_open_modal("Save preset?", 350, 140, -1, comp_cape_customizer:com50);

def_component $popup = comp_cape_customizer:com10;
def_component $content_box = comp_cape_customizer:com50;
def_int $box_w = if_getwidth($content_box);
def_int $box_h = if_getheight($content_box);

def_int $text_w = parawidth($msg, $box_w, verdana_11pt_regular);
def_int $text_h = paraheight($msg, $box_h, verdana_11pt_regular);
def_int $button_x = calc(($box_w - (36 * 4 + 16)) / 2);
def_int $button_y = calc($box_h - 48);
def_int $sub = 0;

cc_create($content_box, ^iftype_text, $sub);
$sub = calc($sub + 1);
cc_setsize($text_w, calc($box_h - 50), ^setsize_abs, ^setsize_abs);
cc_setposition(calc(($box_w - $text_w) / 2), 0, ^setpos_abs_left, ^setpos_abs_top);
cc_setcolour(0xff981f);
cc_settext($msg);
cc_settextfont(verdana_11pt_regular);
cc_settextshadow(true);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 11);

$sub = ~create_v2_stone_button_filled_free($content_box, $sub, calc(36 * 2), 40, $button_x, $button_y, "\<lt>\<lt>   Back", 0xff981f, 0xff981f, 0, 0);
cc_setop(1, "Back");
cc_setonop("cape_customizer_colorpicker_cancel($popup)");
$button_x = add($button_x, calc(36 * 2 + 8));

$sub = ~create_v2_stone_button_filled_free($content_box, $sub, calc(36 * 2), 40, $button_x, $button_y, "Accept", ^green, 0xdfdfdf, 0, 0);
cc_setop(1, "Confirm");
cc_setonop("cape_customizer_apply_preset(0, $preset_index)");

// 20553
[proc,color_picker_h_init](component $parent)
def_int $index;
while ($index < if_getheight($parent)) {
    def_int $scaled = scale($index, if_getheight($parent), 255);
    if (cc_find($parent, $index) = ^false) {
        cc_create($parent, ^iftype_rectangle, $index);
    }
    cc_setcolour(~rgb_to_hex(~hsb_to_rgb($scaled, 255, 255)));
    cc_setsize(0, 1, 1, 0);
    cc_setposition(0, $index, 0, 0);
    cc_setfill(true);
    $index = calc($index + 1);
}

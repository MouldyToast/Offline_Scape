// 20312
[clientscript,cape_customizer_colorpicker_onselect](int $opindex, component $component1, int $com_sub, component $component3, int $colour_idx, int $colour, component $component5, int $int6, int $int7, struct $struct8, component $component9, int $int10, int $int11, int $int12, int $int13)
if ($opindex ! 1) {
    return;
}
if (cc_find($component1, $com_sub) = ^true) {
    cc_settrans(200);
    cc_setontimer("cc_settrans_temporarily_end(event_com, event_comsubid, 0, calc(clientclock + 20))");
}
%cape_customizer_next_color = $colour;
~meslayer_color_update($component3, $colour, $component5, $int6, $int7, $struct8, $component9, $int10, $int11, $int12, $int13);

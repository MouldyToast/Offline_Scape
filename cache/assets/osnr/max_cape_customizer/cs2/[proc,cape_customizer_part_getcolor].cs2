// 20310
[proc,cape_customizer_part_getcolor](int $slot)(int)
switch_int ($slot) {
    case 0 :
        return(%cape_customizer_detail_top);
    case 1 :
        return(%cape_customizer_background_top);
    case 2 :
        return(%cape_customizer_detail_bottom);
    case 3 :
        return(%cape_customizer_background_bottom);
}
return(0);

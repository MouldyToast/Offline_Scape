// 20333
[proc,cape_customizer_main_create_rect](component $com0, int $sub, int $int2, int $int3, int $int4, int $int5)(int)
cc_create($com0, ^iftype_rectangle, $sub);
$sub = calc($sub + 1);
cc_setposition($int2, $int3, ^setpos_abs_left, ^setpos_abs_top);
cc_setsize($int4, $int5, ^setsize_abs, ^setsize_abs);
cc_setfill(false);
cc_setcolour(0x383023);
cc_create($com0, ^iftype_rectangle, $sub);
$sub = calc($sub + 1);
cc_setposition(calc($int2 + 1), calc($int3 + 1), ^setpos_abs_left, ^setpos_abs_top);
cc_setsize(calc($int4 - 2), calc($int5 - 2), ^setsize_abs, ^setsize_abs);
cc_setfill(false);
cc_setcolour(0x5a5245);
return($sub);

[proc,packed_rgb_to_hsl](int $rgb)(int, int, int)
def_int $r = and(~shr($rgb, 16), 0xff);
def_int $g = and(~shr($rgb, 8), 0xff);
def_int $b = and($rgb, 0xff);
return(~rgb_to_hsl($r, $g, $b));

[proc,rgb_to_hsl](int $r, int $g, int $b)(int, int, int)
def_int $max = max($r, max($g, $b));
def_int $min = min($r, min($g, $b));

def_int $lightness = calc(($max + $min) / 2);
def_int $hue = 0;
def_int $saturation = 0;
if ($max ! $min) {// is chromatic / has lightness
    def_int $chroma = calc($max - $min);
    if ($lightness < 128) {
        $saturation = calc(256 * $chroma / ($max + $min));
    } else {
        $saturation = calc(256 * $chroma / (512 - ($max + $min)));
    }

    if ($r = $max) {
        $hue = calc(($g - $b) * 256 / $chroma);
    } else if ($g = $max) {
        $hue = calc(2 * 256 + ($b - $r) * 256 / $chroma);
    } else {
        $hue = calc(4 * 256 + ($r - $g) * 256 / $chroma);
    }

    $hue = calc($hue / 6);

    if ($saturation < 0) {
        $saturation = 0;
    } else if ($saturation > 255) {
        $saturation = 255;
    }
    if ($lightness < 0) {
        $lightness = 0;
    } else if ($lightness > 255) {
        $lightness = 255;
    }
}
return ($hue, $saturation, $lightness);

[proc,hsb_to_hsl](int $h, int $s, int $b)(int, int, int)
def_int $l = calc(((512 - $s) * $b) / 2);

if ($l ! 0) {
    if ($l = 255) {
        $s = 0;
    } else if ($l < 128) {
        $s = calc(($s * $b) / ($l * 2));
    } else {
        $s = calc(($s * $b) / (512 - $l * 2));
    }
}
return ($h, $s, $l);

[proc,hsb_to_rgb](int $h, int $s, int $b)(int,int,int)
if ($s = 0) {
    return($b, $b, $b);
}

// There are 6 color regions; Usually HSB is 0-360 degrees so we'd do $h / 60
// But the range is 0-255 so we divide by 43 to cut 6 regions
def_int $region = calc($h / 43);
def_int $remainder = calc(($h - ($region * 43)) * 6);
def_int $p = calc(($b * (255 - $s)) / 256);
def_int $q = calc(($b * (255 - (($s * $remainder) / 256))) / 256);
def_int $t = calc(($b * (255 - (($s * (255 - $remainder)) / 256))) / 256);

switch_int ($region) {
    case 0 :
        return ($b, $t, $p);
    case 1 :
        return ($q, $b, $p);
    case 2 :
        return ($p, $b, $t);
    case 3 :
        return ($p, $q, $b);
    case 4 :
        return ($t, $p, $b);
    case default :
        return ($b, $p, $q);
}

/**
 * HSL to Jagex 16bit HSL used on models.
 */
[proc,hsl_to_hsl16](int $h, int $s, int $l)(int)
if ($l > 179) {
    $s = calc($s / 2);
}

if ($l > 192) {
    $s = calc($s / 2);
}

if ($l > 217) {
    $s = calc($s / 2);
}

if ($l > 243) {
    $s = calc($s / 2);
}

def_int $scaled_h = calc($h / 4);
def_int $scaled_s = calc($s / 32);
def_int $scaled_l = calc($l / 2);

def_int $packed = calc(~shl($scaled_s, 7) + ~shl($scaled_h, 10) + $scaled_l);
return ($packed);



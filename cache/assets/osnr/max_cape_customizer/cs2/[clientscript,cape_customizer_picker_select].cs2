// 20569
[clientscript,cape_customizer_picker_select](int $opindex, string $title, int $patch_index)
// Set the index of the detail/part we're modifying.
%cape_customizer_current_block_color_index = $patch_index;
if ($opindex = 1) {
	~cape_customizer_open_colorpicker($title, $patch_index);
} else if ($opindex = 2) {
	~cape_customizer_open_modal("HSB picker", 196, 230, 0, comp_cape_customizer:com25);
} else if ($opindex = 3) {
    def_int $default_hsl = 0;
    def_int $default_rgb = 0;
    $default_hsl, $default_rgb = ~cape_customizer_default_colour($patch_index);
    resume_stringdialog("<tostring($patch_index)>,<tostring($default_rgb)>,<tostring($default_hsl)>");
}

// 20567
[proc,cape_customizer_preset_setcolor](int $preset_index, int $colour_part, int $colour)
switch_int ($preset_index) {
    case 0 :
        switch_int ($colour_part) {
            case 0 :
                %cape_customizer_preset1_slot1 = $colour;
            case 1 :
                %cape_customizer_preset1_slot2 = $colour;
            case 2 :
                %cape_customizer_preset1_slot3 = $colour;
            case 3 :
                %cape_customizer_preset1_slot4 = $colour;
        }
    case 1 :
        switch_int ($colour_part) {
            case 0 :
                %cape_customizer_preset2_slot1 = $colour;
            case 1 :
                %cape_customizer_preset2_slot2 = $colour;
            case 2 :
                %cape_customizer_preset2_slot3 = $colour;
            case 3 :
                %cape_customizer_preset2_slot4 = $colour;
        }
    case 2 :
        switch_int ($colour_part) {
            case 0 :
                %cape_customizer_preset3_slot1 = $colour;
            case 1 :
                %cape_customizer_preset3_slot2 = $colour;
            case 2 :
                %cape_customizer_preset3_slot3 = $colour;
            case 3 :
                %cape_customizer_preset3_slot4 = $colour;
        }
    case 3 :
        switch_int ($colour_part) {
            case 0 :
                %cape_customizer_preset4_slot1 = $colour;
            case 1 :
                %cape_customizer_preset4_slot2 = $colour;
            case 2 :
                %cape_customizer_preset4_slot3 = $colour;
            case 3 :
                %cape_customizer_preset4_slot4 = $colour;
        }
    case 4 :
        switch_int ($colour_part) {
            case 0 :
                %cape_customizer_preset5_slot1 = $colour;
            case 1 :
                %cape_customizer_preset5_slot2 = $colour;
            case 2 :
                %cape_customizer_preset5_slot3 = $colour;
            case 3 :
                %cape_customizer_preset5_slot4 = $colour;
        }
    case 5 :
        switch_int ($colour_part) {
            case 0 :
                %cape_customizer_preset6_slot1 = $colour;
            case 1 :
                %cape_customizer_preset6_slot2 = $colour;
            case 2 :
                %cape_customizer_preset6_slot3  = $colour;
            case 3 :
                %cape_customizer_preset6_slot4 = $colour;
        }
}

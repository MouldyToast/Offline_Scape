// 20295
[proc,cape_customizer_setup_colorswatch](component $com0, string $title, int $index)(int)
cc_deleteall($com0);

def_int $int2 = calc((if_getwidth($com0) - 50) / 2);
def_int $sub = ~thinstonebox($com0, 0);

cc_create($com0, ^iftype_text, $sub);
$sub = calc($sub + 1);
cc_setsize(4, 15, ^setsize_minus, ^setsize_abs);
cc_setposition(1, 4, ^setpos_abs_centre, ^setpos_abs_top);
cc_settext($title);
cc_setcolour(0xff981f);
cc_settextfont(p11_full);
cc_settextshadow(true);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 0);

cc_create($com0, ^iftype_rectangle, $sub);
$sub = calc($sub + 1);
cc_setsize(50, 50, ^setsize_abs, ^setsize_abs);
cc_setposition($int2, 20, ^setpos_abs_left, ^setpos_abs_top);
cc_setfill(true);
def_int $colour = ~cape_customizer_part_getcolor($index);
mes(tostring($colour));
cc_setcolour($colour);
cc_setop(1, "Colour Picker");
cc_setop(2, "HSB Picker");
cc_setop(3, "Default Colour");
cc_setonop("cape_customizer_picker_select(event_op, $title, $index)");
$sub = ~cape_customizer_main_create_rect($com0, $sub, $int2, 20, 50, 50);

return($sub);

// 20558
[clientscript,cape_customizer_open_hsl](string $string0)
~cape_customizer_open_modal("HSB picker", 400, 340, 0, comp_cape_customizer:com25);

def_component $popup = comp_cape_customizer:com10;
def_component $content_box = comp_cape_customizer:com25;
def_int $box_w = if_getwidth($content_box);
def_int $box_h = if_getheight($content_box);
def_int $button_x = calc(($box_w - (36 * 4 + 16)) / 2);
def_int $button_y = calc($box_h - 48);

def_component $bg = comp_cape_customizer:com11;
if_setnoclickthrough(true, $bg);
if_setonclick("cape_customizer_colorpicker_cancel($popup)", $bg);

def_component $back = comp_cape_customizer:com39;
if_setop(1, "Back", $back);
if_setonop("cape_customizer_colorpicker_cancel($popup)", $back);

def_component $confirm = comp_cape_customizer:com40;
if_setop(1, "Confirm", $confirm);
if_setonop("cape_customizer_colorpicker_save_selection($popup)", $confirm);

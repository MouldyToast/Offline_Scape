// 20088
[clientscript,modal_fadebg](int $start_tick, int $target_trans, int $update_rate, component $component)
def_int $delta = calc(clientclock - $start_tick);
if ($delta >= $update_rate) {
	return;
}

def_int $trans = if_gettrans($component);
if ($trans = $target_trans) {
	if_setontimer(null, $component);
	return;
}

if ($trans > $target_trans) {
	if_settrans(calc($trans - min(4, calc($trans - $target_trans))), $component);
} else if ($trans < $target_trans) {
	if_settrans(calc($trans + min(4, calc($target_trans - $trans))), $component);
}

// 20337
[proc,cape_customizer_open_modal](string $title, int $width, int $height, int $int3, component $layer)
if_sethide(false, comp_cape_customizer:com10);
if_setnoclickthrough(false, comp_cape_customizer:com10);
~steelborder(comp_cape_customizer:com13, $title, 1);

if_setsize($width, $height, ^setsize_abs, ^setsize_abs, comp_cape_customizer:com12);
if_sethide(true, comp_cape_customizer:com15);
if_sethide(true, comp_cape_customizer:com25);
if_sethide(true, comp_cape_customizer:com50);
if_sethide(false, $layer);

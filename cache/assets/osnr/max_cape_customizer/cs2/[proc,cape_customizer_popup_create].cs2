// 20336
[proc,cape_customizer_popup_create](int $int0, string $type1, string $string0)
def_int $int1 = 0;
def_int $type2 = 0;

def_int $int5 = 350;
def_int $int6 = 140;
def_int $int7 = calc(paraheight($type1, $int5, p12_full) * 15);

if_sethide(false, comp_cape_customizer:com10);
~steelborder(comp_cape_customizer:com13, $type1, 1);

//if_sethide(true, comp_cape_customizer:com17);
//if_sethide(true, comp_cape_customizer:com18);
//if_sethide(true, comp_cape_customizer:com19);
//if_sethide(true, comp_cape_customizer:com20);

if_setsize($int5, $int6, ^setsize_abs, ^setsize_abs, comp_cape_customizer:com12);
if_setonclick("modal_resetbg(comp_cape_customizer:com11)", comp_cape_customizer:com10);
if_sethide(true, comp_cape_customizer:com15);
if_sethide(true, comp_cape_customizer:com50);
if_sethide(true, comp_cape_customizer:com25);
if_sethide(false, comp_cape_customizer:com15);
~modal_start_fadebg(25, comp_cape_customizer:com11);

$type2 = 0;
cc_create(comp_cape_customizer:com16, ^iftype_text, $type2);
$type2 = calc($type2 + 1);
cc_setsize($int5, $int7, ^setsize_abs, ^setsize_abs);
cc_setposition(0, $int7, ^setpos_abs_left, ^setpos_abs_top);
cc_setcolour(0xff981f);
cc_settext($string0);
cc_settextfont(p12_full);
cc_settextshadow(true);
cc_settextalign(^settextalign_centre, ^settextalign_centre, 15);


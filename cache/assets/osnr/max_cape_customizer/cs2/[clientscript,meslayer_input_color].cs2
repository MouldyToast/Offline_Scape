// 20559
[clientscript,meslayer_input_color](int $int0, component $component1, component $component2, int $int3, int $int4, struct $struct5, component $component6, int $int7, int $int8, int $int9, int $int10)
%settings_search_right = 0;
%settings_amount_typing = 1;
sound_synth(interface_select1, 1, 0);
if ($int0 > 3) {
    return;
}
switch_int ($int0) {
    case 0 :
        ~meslayer_color_show_input("Enter a hex code: (0-9, a-f, format: #RRGGBB)", 22, $component1, $component2, $int3, $int4, $struct5, $component6, $int7, $int8, $int9, $int10);
    case 1 :
        ~meslayer_color_show_input("Enter a value for red (0-255)", 23, $component1, $component2, $int3, $int4, $struct5, $component6, $int7, $int8, $int9, $int10);
    case 2 :
        ~meslayer_color_show_input("Enter a value for green (0-255)", 24, $component1, $component2, $int3, $int4, $struct5, $component6, $int7, $int8, $int9, $int10);
    case 3 :
        ~meslayer_color_show_input("Enter a value for blue (0-255)", 25, $component1, $component2, $int3, $int4, $struct5, $component6, $int7, $int8, $int9, $int10);
}

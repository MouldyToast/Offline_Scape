// 20316
[proc,cape_customizer_main_rebuild]
def_int $preset_count = enum_getoutputcount(cape_customizer_preset_layers);
def_int $counter = 0;
while ($counter < $preset_count) {
	def_component $preset_layer = enum(int, component, cape_customizer_preset_layers, $counter);
	~cape_customizer_preset_rebuild($preset_layer, $counter);
	$counter = calc($counter + 1);
}
~cape_customizer_setup_colorswatch(comp_cape_customizer:com4, "Detail (top)", 0);
~cape_customizer_setup_colorswatch(comp_cape_customizer:com5, "Background (top)", 1);
~cape_customizer_setup_colorswatch(comp_cape_customizer:com6, "Detail (bottom)", 2);
~cape_customizer_setup_colorswatch(comp_cape_customizer:com7, "Background (bottom)", 3);


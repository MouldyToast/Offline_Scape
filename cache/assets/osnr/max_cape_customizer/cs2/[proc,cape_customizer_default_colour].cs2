// 20606
// Returns ($hsl, $rgb)
[proc,cape_customizer_default_colour](int $patch_index)(int, int)
if ($patch_index = 0) {
    return(-1475, 13191260);
} else if ($patch_index = 1) {
    return(-1489, 10697546);
} else if ($patch_index = 2) {
    return(-3694, 4596014);
} else {
    return(-1503, 8071992);
}

// 20565
[proc,cape_customizer_part_setcolor](int $index, int $colour)
switch_int ($index) {
	case 0 :
		%cape_customizer_detail_top = $colour;
	case 1 :
		%cape_customizer_background_top = $colour;
	case 2 :
		%cape_customizer_detail_bottom = $colour;
	case 3 :
		%cape_customizer_background_bottom = $colour;
}

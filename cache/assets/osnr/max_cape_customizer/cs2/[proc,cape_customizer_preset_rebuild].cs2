// 20334
[proc,cape_customizer_preset_rebuild](component $type0, int $part_idx)
cc_deleteall($type0);

def_int $sub = 0;
cc_create($type0, ^iftype_graphic, $sub);
$sub = calc($sub + 1);
cc_setposition(-12, 4, ^setpos_abs_centre, ^setpos_abs_bottom);
cc_setsize(16, 16, ^setsize_abs, ^setsize_abs);
cc_setgraphic("save");
cc_setonmouseover("cc_settrans(event_com, event_comsubid, 225, null)");
cc_setonmouseleave("cc_settrans(event_com, event_comsubid, 0, null)");
cc_setop(1, "Save");
cc_setonop("cape_customizer_save_preset($part_idx)");

cc_create($type0, ^iftype_graphic, $sub);
$sub = calc($sub + 1);
cc_setposition(13, 4, ^setpos_abs_centre, ^setpos_abs_bottom);
cc_setsize(16, 16, ^setsize_abs, ^setsize_abs);
cc_setgraphic("load");
cc_setonmouseover("cc_settrans(event_com, event_comsubid, 225, null)");
cc_setonmouseleave("cc_settrans(event_com, event_comsubid, 0, null)");
cc_setop(1, "Load");
cc_setonop("cape_customizer_load_preset($part_idx)");

$sub = ~thinstonebox($type0, $sub);

def_int $colour_slot = 0;
def_int $colours = 4;
while ($colour_slot < $colours) {
    cc_create($type0, ^iftype_rectangle, $sub);
    $sub = calc($sub + 1);
    cc_setsize(18, 18, ^setsize_abs, ^setsize_abs);
    cc_setposition(calc(10 + $colour_slot % 2 * 24), calc(7 + $colour_slot / 2 * 24), ^setpos_abs_left, ^setpos_abs_top);
    cc_setfill(true);
    def_int $colour = ~cape_customizer_preset_getcolor($part_idx, $colour_slot);
    if ($colour <= 0) {
			$colour = ^white;
    }
    cc_setcolour($colour);
    $sub = ~cape_customizer_main_create_rect($type0, $sub, cc_getx, cc_gety, 18, 18);
    $colour_slot = calc($colour_slot + 1);
}

